<launch>
    <!-- 启动本地的 AR 二维码识别与控制主程序 -->
    <include file="$(find limo_visions)/launch/ar_control.launch" />

    <!-- 启动 FKIE Master Discovery 节点 -->
    <node pkg="fkie_master_discovery" type="master_discovery" name="master_discovery" output="screen" />

    <!-- 启动 FKIE Master Sync 节点 -->
    <node pkg="fkie_master_sync" type="master_sync" name="master_sync" output="screen">
        <!-- 同步白名单：需要同步相机的图像数据、相机内参数据，以及回传的控制速度话题 -->
        <rosparam param="sync_topics">
            - /camera/rgb/image_raw
            - /camera/rgb/camera_info
            - /cmd_vel
            - /tf
            - /tf_static
        </rosparam>
        <!-- 忽略不需要同步的其他话题 -->
        <rosparam param="ignore_topics">
            - /rosout
            - /rosout_agg
        </rosparam>
    </node>
</launch>
