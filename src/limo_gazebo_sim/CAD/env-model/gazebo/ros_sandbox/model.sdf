<?xml version="1.0"?>
<sdf version="1.6">
  <model name="ros_sandbox">
    <static>true</static>
    <link name="sandbox_environment">
      <visual name="textured_environment">
        <geometry><mesh><uri>model://ros_sandbox/meshes/ros_sandbox_visual.obj</uri><scale>1 1 1</scale></mesh></geometry>
        <cast_shadows>true</cast_shadows>
      </visual>
      <collision name="environment_collision">
        <geometry><mesh><uri>model://ros_sandbox/meshes/ros_sandbox_collision.stl</uri><scale>1 1 1</scale></mesh></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
    </link>
  </model>
</sdf>
