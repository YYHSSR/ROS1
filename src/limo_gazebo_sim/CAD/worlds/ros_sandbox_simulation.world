<?xml version="1.0"?>
<sdf version="1.6">
  <world name="ros_sandbox_world">
    <gravity>0 0 -9.81</gravity>

    <!-- 物理引擎配置: ODE 1ms 步长，满帧实时更新 -->
    <physics name="ode_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- =========================================================================
         💡【仿真世界光照强度一键量化设置插件 (WorldPlugin)】
         只需在下方 <light_percent> 中手动填写一个 0 ~ 100 的数字，保存后重启世界即可改变光照！
         - 100 : 标准自然日光晴天 (100% 满光照)
         - 70  : 阴天背阴 (70% 光照)
         - 50  : 黄昏微光 (50% 光照)
         - 20  : 深度暗光 (20% 光照，本文算法仍可稳定高精跟踪)
         - 10.5: 极限极夜 (10.5% 极夜，相机传感器光学欠曝断线临界点)
         ========================================================================= -->
    <plugin name="world_light_controller" filename="libgazebo_world_light.so">
      <light_percent>100</light_percent>
      <light_name>sun</light_name>
    </plugin>

    <scene>
      <ambient>0.02625 0.02625 0.02625 1.0</ambient>
      <background>0.1115 0.143 0.1785 1.0</background>
      <shadows>true</shadows>
    </scene>

    <!-- 太阳主光源 -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 50 0 0 0</pose>
      <diffuse>0.105 0.1029 0.09975 1.0</diffuse>
      <specular>0.021 0.021 0.021 1.0</specular>
      <direction>-0.6 0.6 -0.53</direction>
    </light>

    <!-- ================= (当前启用): 固定高质感斜射自然日光 =================
         优势: 彻底 100% 消除任何单帧顿挫/跳变，物理引擎锁定 60 满帧 (RTF 1.00)；
         小车行驶时车体阴影逐帧实时动态跟随，建筑物静态长投影清晰深邃，对视觉车道线识别最稳定。
         ============================================================================= -->

    <!-- 真实感沙盘环境: 2.5 倍等比缩放的高精路面与障碍物 (居中放置在 Gazebo 网格原点) -->
    <model name="ros_sandbox">
      <static>true</static>
      <pose>-4.0 -4.0 0 0 0 0</pose>
      <link name="sandbox_environment">
        <!-- 1. 地面与路面 (接收动态阴影，关闭自投射以实现障碍物阴影投射并极大提升渲染性能) -->
        <visual name="ground_visual">
          <geometry>
            <mesh>
              <uri>file:///home/zf/catkin_ws/src/limo_gazebo_sim/CAD/meshes/ros_sandbox_ground.obj</uri>
              <scale>2.5 2.5 2.5</scale>
            </mesh>
          </geometry>
          <cast_shadows>false</cast_shadows>
        </visual>

        <!-- 2. 障碍物、建筑、树木、围墙与平台 (投射清晰真实的三维动态阴影到路面) -->
        <visual name="obstacles_visual">
          <geometry>
            <mesh>
              <uri>file:///home/zf/catkin_ws/src/limo_gazebo_sim/CAD/meshes/ros_sandbox_obstacles.obj</uri>
              <scale>2.5 2.5 2.5</scale>
            </mesh>
          </geometry>
          <cast_shadows>true</cast_shadows>
        </visual>

        <collision name="environment_collision">
          <geometry>
            <mesh>
              <uri>file:///home/zf/catkin_ws/src/limo_gazebo_sim/CAD/meshes/ros_sandbox_collision.stl</uri>
              <scale>2.5 2.5 2.5</scale>
            </mesh>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
      </link>
    </model>

    <!-- 俯瞰观察摄像机初始位姿: 瞄准沙盘中心 (0, 0, 0) -->
    <gui fullscreen="0">
      <camera name="sandbox_overview">
        <pose>13.5 -19.0 17.5 0 0.65 2.17</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>
  </world>
</sdf>
