<?xml version="1.0"?>
<sdf version="1.6">
  <world name="ros_sandbox_world">
    <gravity>0 0 -9.81</gravity>
    <physics name="ode_physics" type="ode"><max_step_size>0.001</max_step_size><real_time_update_rate>1000</real_time_update_rate></physics>
    <!-- 动态白天光照与自然昼夜天空系统: 正午(12:00)日照、自然动态流云与实时阴影 -->
    <scene>
      <sky>
        <time>12.0</time>
        <sunrise>6.0</sunrise>
        <sunset>18.0</sunset>
        <clouds>
          <speed>12</speed>
          <humidity>0.3</humidity>
          <mean>0.4</mean>
        </clouds>
      </sky>
      <ambient>0.6 0.6 0.6 1.0</ambient>
      <background>0.7 0.8 0.9 1.0</background>
      <shadows>true</shadows>
    </scene>

    <!-- 太阳主光源: 自然直射日光，投射高精度动态阴影 -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1.0</diffuse>
      <specular>0.2 0.2 0.2 1.0</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.3 0.4 -1.0</direction>
    </light>
    <model name="background_ground"><static>true</static><pose>0 0 -0.02 0 0 0</pose><link name="ground"><collision name="ground_collision"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry></collision><visual name="ground_visual"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry><material><ambient>0.3 0.33 0.35 1</ambient><diffuse>0.3 0.33 0.35 1</diffuse></material></visual></link></model>
    <model name="ros_sandbox">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="sandbox_environment">
        <visual name="textured_environment">
          <geometry><mesh><uri>file:///home/zf/catkin_ws/src/limo_gazebo_sim/CAD/meshes/ros_sandbox_visual.obj</uri><scale>2.5 2.5 2.5</scale></mesh></geometry>
          <cast_shadows>true</cast_shadows>
        </visual>
        <collision name="environment_collision">
          <geometry><mesh><uri>file:///home/zf/catkin_ws/src/limo_gazebo_sim/CAD/meshes/ros_sandbox_collision.stl</uri><scale>2.5 2.5 2.5</scale></mesh></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
      </link>
    </model>
    <gui fullscreen="0"><camera name="sandbox_overview"><pose>17.5 -15 17.5 0 0.65 2.17</pose><view_controller>orbit</view_controller></camera></gui>
  </world>
</sdf>
