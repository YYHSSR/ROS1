<?xml version="1.0"?>
<sdf version="1.6">
  <world name="ros_sandbox_world">
    <gravity>0 0 -9.81</gravity>

    <!-- 物理引擎配置: ODE 1ms 步长，满帧实时更新 -->
    <physics name="ode_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- 场景配置: 白天自然天蓝背景，调优环境光与阳光对比度强化阴影 -->
    <scene>
      <ambient>0.25 0.25 0.25 1.0</ambient>
      <background>0.53 0.68 0.85 1.0</background>
      <shadows>true</shadows>
    </scene>

    <!-- 太阳主光源: 低高度斜射日光角度，加长阴影投影长度并强化明暗对比
         方向矢量: azimuth≈NW, elevation≈32° (dz=-0.53, |dxy|≈0.85) -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 50 0 0 0</pose>
      <diffuse>1.0 0.98 0.95 1.0</diffuse>
      <specular>0.2 0.2 0.2 1.0</specular>
      <direction>-0.6 0.6 -0.53</direction>
    </light>

    <!-- 动态日光插件: 控制太阳方位角与高度角，保持阴影明显且缓慢平滑移动
         elevation 设为 25°~50°，避免正午超高仰角导致阴影缩短不可见 -->
    <plugin name="dynamic_sun" filename="libgazebo_dynamic_sun.so">
      <cycle_period>180.0</cycle_period>
      <min_elevation>25.0</min_elevation>
      <max_elevation>50.0</max_elevation>
      <update_interval>5.0</update_interval>
      <light_name>sun</light_name>
    </plugin>

    <!-- 真实感沙盘环境: 2.5 倍等比缩放的高精路面与障碍物 (居中放置在 Gazebo 网格原点) -->
    <model name="ros_sandbox">
      <static>true</static>
      <pose>-4.0 -4.0 0 0 0 0</pose>
      <link name="sandbox_environment">
        <!-- 1. 地面与路面 (接收动态阴影，关闭自投射以实现障碍物阴影投射并极大提升渲染性能) -->
        <visual name="ground_visual">
          <geometry>
            <mesh>
              <uri>file:///home/zf/catkin_ws/src/limo_gazebo_sim/CAD/meshes/ros_sandbox_ground.obj</uri>
              <scale>2.5 2.5 2.5</scale>
            </mesh>
          </geometry>
          <cast_shadows>false</cast_shadows>
        </visual>

        <!-- 2. 障碍物、建筑、树木、围墙与平台 (投射清晰真实的三维动态阴影到路面) -->
        <visual name="obstacles_visual">
          <geometry>
            <mesh>
              <uri>file:///home/zf/catkin_ws/src/limo_gazebo_sim/CAD/meshes/ros_sandbox_obstacles.obj</uri>
              <scale>2.5 2.5 2.5</scale>
            </mesh>
          </geometry>
          <cast_shadows>true</cast_shadows>
        </visual>

        <collision name="environment_collision">
          <geometry>
            <mesh>
              <uri>file:///home/zf/catkin_ws/src/limo_gazebo_sim/CAD/meshes/ros_sandbox_collision.stl</uri>
              <scale>2.5 2.5 2.5</scale>
            </mesh>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
      </link>
    </model>

    <!-- 俯瞰观察摄像机初始位姿: 瞄准沙盘中心 (0, 0, 0) -->
    <gui fullscreen="0">
      <camera name="sandbox_overview">
        <pose>13.5 -19.0 17.5 0 0.65 2.17</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>
  </world>
</sdf>
