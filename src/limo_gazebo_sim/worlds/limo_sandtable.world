              <uri>file://media/materials/scripts/gazebo.material</uri>
            </script>
          </material>
        </visual>
        <!-- Pole -->
        <collision name='pole_collision'>
          <pose>0 0 0.27 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.015</radius>
              <length>0.5</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name='pole_visual'>
          <pose>0 0 0.27 0 0 0</pose>
