<?xml version="1.0" ?>
<sdf version="1.5">
  <world name="graduation_world">
    <!-- 真实感环境渲染配置: 云彩天空盒、大气漫反射与动态物理阴影 -->
    <scene>
      <sky>
        <time>14.0</time>
        <sunrise>6.0</sunrise>
        <sunset>18.0</sunset>
        <clouds>
          <speed>12</speed>
        </clouds>
      </sky>
      <ambient>0.5 0.5 0.5 1.0</ambient>
      <background>0.6 0.78 1.0 1.0</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <!-- 太阳真实方向光源配置 -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- 真实感沥青/水泥地面 -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- 物理引擎配置 -->
    <physics type='ode'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <gravity>0 0 -9.8</gravity>
    </physics>

    <!-- 加载 SolidWorks 毕设场景模型 -->
    <model name="graduation_scene">
      <static>true</static>
      <!-- 姿态配置: [x y z roll pitch yaw] -->
      <pose>-4.816 4.896 0 1.570796 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>file:///home/zf/catkin_ws/src/limo_gazebo_sim/meshes/ROS1.STL</uri>
              <scale>2 2 2</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <mesh>
              <uri>file:///home/zf/catkin_ws/src/limo_gazebo_sim/meshes/ROS1.STL</uri>
              <scale>2 2 2</scale>
            </mesh>
          </geometry>
        </collision>
      </link>
    </model>
  </world>
</sdf>
